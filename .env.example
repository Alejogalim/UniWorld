# Copy to .env and fill in your keys. .env is gitignored.
#
# OpenCode Go (experimental: Counselor chat only, no web search)
OPENCODE_API_KEY=
#
# OpenRouter (required for Finder / verified web search)
OPENROUTER_API_KEY=
#
# Optional: override the OpenRouter model id
UNIFINDER_MODEL=
#
# Optional: override the OpenCode Go model id
UNIFINDER_OPENCODE_MODEL=
#
# Optional: counselor CLI default provider (openrouter | opencode)
UNIFINDER_DEFAULT_PROVIDER=opencode

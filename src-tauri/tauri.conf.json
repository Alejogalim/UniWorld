{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniWorld",
  "version": "0.1.0",
  "identifier": "com.uniworld.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UniWorld",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "UniWorld contributors",
    "shortDescription": "Find real universities worldwide",
    "longDescription": "UniWorld helps high-school students in IB, AP or US programs find real universities worldwide. A Socratic counselor helps them think about careers, and every fact shown has a source link and a verified quote.",
    "category": "Education",
    "copyright": "Copyright (c) 2026 UniWorld contributors. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:uniworld.db"
      ]
    }
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://openrouter.ai/*"
        },
        {
          "url": "https://opencode.ai/*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
